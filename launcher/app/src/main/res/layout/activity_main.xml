<?xml version="1.0" encoding="utf-8"?>
<!-- Cine board, 1280x720 px, at 960x540 dp: every size below is the mock's px x 0.75. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <com.gathin.tvhome.ArtView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- clipChildren off down to the row: a tile lifted by Mover rises above the row's own bounds. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="352dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingTop="28dp"
                android:paddingEnd="48dp">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.24"
                    android:textColor="@color/ink"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textColor="@color/ink"
                    android:textSize="13.5sp" />

                <ImageView
                    android:id="@+id/wifi"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/wifi"
                    android:padding="9.5dp"
                    android:src="@drawable/ic_wifi" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/selected_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.2"
                    android:text="@string/selected"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="420dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="10dp"
                    android:autoSizeMaxTextSize="90sp"
                    android:autoSizeMinTextSize="40sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="345dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="2"
                    android:minLines="2"
                    android:textColor="@color/ink_soft"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:text="@string/channels"
            android:textColor="@color/ink_mute"
            android:textSize="10.5sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="15dp"
            android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="42dp"
                android:layout_marginEnd="42dp"
                android:clipChildren="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <!-- Shown only while there is another page on that side; the D-pad does the paging. -->
            <ImageView
                android:id="@+id/arrow_left"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_left"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/arrow_right"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                android:visibility="invisible" />
        </FrameLayout>
    </LinearLayout>

    <!-- Holding OK on a tile: placed over that tile in code, filled with what that app allows. -->
    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone" />
</FrameLayout>
